// ADR-0004 のクラウド構成をコードで持つ。手動のダッシュボード設定を正にしない。
//
// 注意 1: wrangler の名前付き環境は**上位の設定を引き継がない**。
//         vars もバインディングも env ごとに書く。省くと本番で undefined になる。
// 注意 2: wrangler の設定ファイルに `${VAR}` の展開は無い。ID は直接書く。
//         D1 / KV / Queue の ID は**秘密ではない**ので、そのままコミットしてよい。
//         秘密は Workers Secrets のみ（`C-06`）。
// 注意 3: リソースの作成は `scripts/bootstrap.sh`。dev / prod は人が一度だけ。
//         test は隔離環境なので deploy-test が冪等に作ってよい。
//
// 前提（ADR-0004）:
//   - HTTP と cron を 1 つの Worker に同居させる（分けると設定と型が二重になる）
//   - cron はアカウントで 5 本まで（Free）。日次収集に使うのは dev / prod の各 1 本
//   - test / dev / prod で D1 を分ける（Free で 10 DB まで）
//   - test は Claude scan 用の隔離環境。cron は付けない（日次収集しない）
//   - 公開面（prod）はゾーン配下の独自ドメイン。workers.dev は防御の前提にしない
//   - test の公開面は workers.dev のまま（スキャン専用。ゾーン防御の対象外でよい）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-research-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  // 既定環境は置かない。必ず --env test / --env dev / --env prod を指定する。
  // ここに書いた値は env に引き継がれないので、下の env が実体。

  "env": {
    "dev": {
      "name": "ai-research-api-dev",
      "vars": {
        "ENVIRONMENT": "dev",
        "CONSENT_VERSION": "1",
        "LLM_DAILY_CALL_LIMIT": "20",
        // ADR-0005 §2: 段ごとの Named Router。コンソールに無い間は素のモデル ID を入れて逃がす
        "ORCA_ROUTER_COLLECT": "orcarouter/rs-collect",
        "ORCA_ROUTER_REVIEW": "orcarouter/rs-review"
      },
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-research-dev",
          "database_id": "a379335e-6c93-4d84-87b2-34be95717e2e",
          "migrations_dir": "./migrations"
        }
      ],
      // 収集実行の冪等キー。cron・Queues とも at-least-once のため
      "kv_namespaces": [{ "binding": "IDEMPOTENCY", "id": "88e7f74ecbe34e5eb8b6bd1871ea39c5" }],
      "queues": {
        "producers": [{ "binding": "COLLECT_QUEUE", "queue": "ai-research-collect-dev" }],
        "consumers": [
          {
            "queue": "ai-research-collect-dev",
            // 1 メッセージ = 1（プロジェクト × ソース）。CPU 10ms 枠をメッセージごとに使う
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "ai-research-collect-dev-dlq"
          }
        ]
      },
      // UTC のみ。夏時間の影響を受けない時刻を選ぶ（ADR-0004）
      "triggers": { "crons": ["0 20 * * *"] }
    },

    // Claude scan / 手動検証用。dev（staging 相当）の D1 を汚さない。
    // cron は付けない。ID は秘密ではないので dev / prod と同じくコミットする。
    "test": {
      "name": "ai-research-api-test",
      "vars": {
        "ENVIRONMENT": "test",
        "CONSENT_VERSION": "1",
        "LLM_DAILY_CALL_LIMIT": "20",
        "ORCA_ROUTER_COLLECT": "orcarouter/rs-collect",
        "ORCA_ROUTER_REVIEW": "orcarouter/rs-review"
      },
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-research-test",
          "database_id": "8c29caf9-1f7b-4b70-aa7a-d043bd3d44bf",
          "migrations_dir": "./migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "IDEMPOTENCY", "id": "57854abc3b1e42f9bd23f673a8193787" }],
      "queues": {
        "producers": [{ "binding": "COLLECT_QUEUE", "queue": "ai-research-collect-test" }],
        "consumers": [
          {
            "queue": "ai-research-collect-test",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "ai-research-collect-test-dlq"
          }
        ]
      }
      // cron なし。Free はアカウント 5 本。scan 用に日次収集は要らない
    },

    "prod": {
      "name": "ai-research-api",
      "vars": {
        "ENVIRONMENT": "prod",
        "CONSENT_VERSION": "1",
        "LLM_DAILY_CALL_LIMIT": "20",
        // ADR-0005 §2: 段ごとの Named Router。コンソールに無い間は素のモデル ID を入れて逃がす
        "ORCA_ROUTER_COLLECT": "orcarouter/rs-collect",
        "ORCA_ROUTER_REVIEW": "orcarouter/rs-review"
      },
      "observability": { "enabled": true },
      // 公開面はゾーン配下の独自ドメイン。ゾーンの WAF / レート制限を効かせるため。
      // api.streeeak.link は別プロジェクト（Cloudflare Tunnel）が使う。被せない。
      // custom_domain: true はデプロイ時に DNS も作る。既存 A/CNAME があると 100117 で落ちる。
      "routes": [{ "pattern": "ai-research.streeeak.link", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-research-prod",
          "database_id": "91955c65-86a1-4cae-937b-5128971e4353",
          "migrations_dir": "./migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "IDEMPOTENCY", "id": "413fe15c2bf7447abe41168e812c50eb" }],
      "queues": {
        "producers": [{ "binding": "COLLECT_QUEUE", "queue": "ai-research-collect" }],
        "consumers": [
          {
            "queue": "ai-research-collect",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "ai-research-collect-dlq"
          }
        ]
      },
      "triggers": { "crons": ["0 20 * * *"] }
    }
  }
}

{
  "name": "ai-research-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "研究トレンドの自動追跡（課題意識に近い候補の収集・ローカル関連度順位）",
  "author": "uzak0209",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --config --publish never",
    "dist:win": "npm run build && electron-builder --win --config --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@ai-research/core": "file:../packages/core",
    "@huggingface/transformers": "^4.3.0",
    "pdfjs-dist": "^6.3.289",
    "sqlite-vec": "^0.1.9"
  }
}

{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "electron"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "test/**/*.ts", "electron.vite.config.ts", "vitest.config.ts"]
}

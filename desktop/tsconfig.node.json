{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "electron"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    // レンダラ側でも pdf.js を読まない純粋な処理はテストから参照する。
    // 1 本ずつ列挙すると足し忘れるのでまとめて含める
    "src/renderer/ink-path.ts",
    "src/renderer/rects.ts",
    "test/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
